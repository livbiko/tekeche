# dependencies
node_modules/

# env files
.env
.env.local
.env*.local

# credentials
*.pem
*.key
*.pfx
*.p12

# macOS
.DS_Store

# IDE
.vscode/
.cursor/
.claude/
.idea/

# logs
*.log
logs/

# submodules (managed as separate repos)
/tekeche-api/
/tekeche-mobile/
/tekeche-payment-gateway/

# recovery-point snapshots — contain env-keys.txt and full db-dumps, never commit
ops/recovery-points/

# local backup copy of tekeche-api (contains real .env files + node_modules)
DCFILES/

# k8s Secret manifests with plaintext creds inline (e.g. Redis Sentinel's
# auth-pass) -- only *-create-secret.ps1 scripts (which apply via kubectl,
# never commit the literal value) are tracked, matching the woyo repo's
# convention. Found 2026-07-30 when 07-sentinel-secret.yaml showed up
# untracked with a real password in it.
ops/k8s/**/*-secret.yaml

# OCI Terraform secrets
ops/oci/terraform.tfvars
ops/oci/terraform.tfvars.bak*
ops/oci/.terraform/
ops/oci/*.tfstate
ops/oci/*.tfstate.backup
ops/oci/*.tfstate.bak*
# broader pattern for the numbered-timestamp form Terraform actually writes
# (terraform.tfstate.<timestamp>.backup) -- the two patterns above don't
# match it, found 2026-07-18 when several showed up as untracked
ops/oci/terraform.tfstate.*.backup

# OCI Terraform run artifacts (plan/apply logs, saved plans)
ops/oci/tfplan*
ops/oci/*.tfplan
ops/oci/apply-*.txt
ops/oci/plan-*.txt
ops/oci/PktMon.txt
ops/bot-fleet/fleet-state.json
ops/bot-fleet/logs/
ops/bot-fleet/STOP
