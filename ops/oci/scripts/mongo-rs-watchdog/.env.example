# Needs a dedicated Mongo user with clusterManager role on admin -- do not reuse
# tekeche-api's app-scoped user, it can't run replSetReconfig.
# Create with (on the current primary):
#   use admin
#   db.createUser({ user: "mongoWatchdog", pwd: "<generate>", roles: [{ role: "clusterManager", db: "admin" }] })
MONGO_ADMIN_URI=mongodb://mongoWatchdog:<password>@10.0.2.10:27017,10.0.2.20:27017,10.0.2.21:27017/admin?replicaSet=rs0&authSource=admin

WATCHED_HOSTS=192.168.1.101:27017,192.168.1.102:27017
DOWN_THRESHOLD_MS=120000
UP_THRESHOLD_MS=60000
POLL_INTERVAL_MS=15000
PROBE_TIMEOUT_MS=3000
MIN_REMAINING_MEMBERS=3
STATE_FILE=/opt/mongo-rs-watchdog/state.json
KILL_SWITCH_FILE=/opt/mongo-rs-watchdog/DISABLED
